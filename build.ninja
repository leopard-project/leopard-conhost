# leopard-conhost 构建 + xbps 打包
ninja_required_version = 1.10
cc = clang
cxx = clang++
ld = ld
c_flags = -fdiagnostics-color=always -O2 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -fno-stack-protector -fno-exceptions -fno-strict-aliasing -fshort-wchar -nostdinc -std=c11   -I ../XJ380-SDK/out/crt/include -I . -MMD -MP
cpp_flags = -fdiagnostics-color=always -O2 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -fno-stack-protector -fno-exceptions -fno-strict-aliasing -fshort-wchar -nostdinc -std=c++11 -I ../XJ380-SDK/out/crt/include -I . -Wno-write-strings -MMD -MP

rule cc
  command = mkdir -p $$(dirname $out) && $cc $c_flags -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule cxx
  command = mkdir -p $$(dirname $out) && $cxx $cpp_flags -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule link
  command = $ld -Ttext=0x200000 $in -o $out

build out/main.c.o: cc main.c
build out/console_host.c.o: cc console_host.c

build out/leopard-conhost.elf: link ../XJ380-SDK/out/crt/lib/x86_64/crt0.o ../XJ380-SDK/out/crt/lib/x86_64/start.o out/main.c.o out/console_host.c.o ../XJ380-SDK/out/crt/lib/x86_64/libxact.a ../XJ380-SDK/out/crt/lib/x86_64/liballoc.a

rule package
  command = rm -rf .pkg && mkdir -p .pkg/$$(dirname apps/leopard/leopard-conhost.elf) && cp out/leopard-conhost.elf .pkg/apps/leopard/leopard-conhost.elf && cd out && xbps-create --compression gzip -A x86_64 -n leopard-conhost-1.0_1 -s "Leopard console host" ../.pkg

build out/leopard-conhost-1.0_1.x86_64.xbps: package out/leopard-conhost.elf
build build: phony out/leopard-conhost.elf
build pack: phony out/leopard-conhost-1.0_1.x86_64.xbps
default build
rule clean
  command = rm -rf out .pkg
build clean: clean
